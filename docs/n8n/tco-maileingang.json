      "parameters": {
        "method": "POST",
        "url": "http://app:8080/api/m/tco/eingang/mail",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "name": "An Portal liefern",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Portal API-Schlüssel (Bearer)"
        }
      },
      "notes": "Ein Aufruf für alles: Das Portal verbucht Rückmeldungen (unzustellbar, Abwesenheit, Antwort) im E-Mail-Protokoll und legt Dokumente nach dem Regelwerk ab. Zugangsdaten „Header Auth“: Name Authorization, Wert „Bearer pk_tco_…“ (API-Schlüssel TC Oberthal mit tco.eingang:melden)."
    },
    {
      "parameters": {
        "jsCode": "// Nach erfolgreicher Lieferung ans Portal: Mails merken, damit sie beim nächsten Abruf nicht erneut geliefert werden.\n// (Schlägt die Lieferung fehl, bleibt nichts gemerkt – der nächste Lauf versucht es wieder; das Portal verarbeitet nichts doppelt.)\nconst merk = $getWorkflowStaticData('global');\nconst neu = $input.all().map((_, i) => $('Für Portal packen').itemMatching(i).json.schluessel).filter(Boolean);\nmerk.gemeldet = [...new Set([...(merk.gemeldet || []), ...neu])].slice(-3000);\nreturn $input.all();\n"
      },
      "name": "Gemeldet merken",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
