    {
      "parameters": {
        "authentication": "imapThisNode",
        "resource": "email",
        "operation": "getEmailsList",
        "mailboxPath": {
          "__rl": true,
          "mode": "path",
          "value": "INBOX"
        },
        "emailDateRange": {
          "since": "={{ $now.minus({ days: 2 }).toISO() }}"
