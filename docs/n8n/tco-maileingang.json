    {
      "parameters": {
        "jsCode": "// Mail und – falls vorhanden – die geladenen Anhänge (Base64) zu einer Lieferung an das Portal zusammenfassen.\n// Optional: text je Anhang = Dokumenttext (z. B. aus „Extract from File“), damit Regeln auf den Inhalt prüfen können.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const it = items[i];\n  const geladen = Array.isArray(it.json.attachments);\n  const mail = geladen ? $('Mail aufbereiten').itemMatching(i).json : it.json;\n  const anhaenge = [];\n  if (geladen) {\n    for (const a of it.json.attachments) {\n      const daten = await this.helpers.getBinaryDataBuffer(i, a.binaryFieldName);\n      anhaenge.push({ name: a.filename || a.binaryFieldName, mime: a.contentType || null, inhalt: daten.toString('base64'), text: '' });\n    }\n  }\n  const { anhaenge_anzahl, ...rest } = mail;\n  out.push({ json: { ...rest, anhaenge }, pairedItem: { item: i } });\n}\nreturn out;\n"
      },
      "name": "Für Portal packen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
