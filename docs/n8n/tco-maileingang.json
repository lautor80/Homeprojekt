      },
      "name": "Posteingang lesen (IMAP Benjamin)",
      "type": "n8n-nodes-imap.imap",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "notes": "Weiteres Postfach: Zugangsdaten wählen, aktivieren und in „Mail aufbereiten“ unter POSTFAECHER benennen. Die IMAP-Knoten zum Laden der Anhänge und im unteren Zweig brauchen je Postfach eine eigene Kopie mit dessen Zugangsdaten.",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Neue Mails der Posteingänge für das Portal aufbereiten (Dokumenteneingang und Rückmeldungen zum E-Mail-Protokoll).\n// Das Portal verbucht Unzustellbar-Meldungen, Abwesenheitsnotizen und Antworten im E-Mail-Protokoll und legt Dokumente\n// nach dem Regelwerk ab. Bereits gelieferte Mails (Knoten „Gemeldet merken“) und Mails älter als TAGE werden übersprungen.\nconst TAGE = 3;\n// Name des Postfachs je IMAP-Knoten – Teil des Schlüssels im Portal (Postfach + Message-ID) und Bedingungsfeld „Postfach“\nconst POSTFAECHER = {\n  'Posteingang lesen (IMAP)': 'Verein',\n  'Posteingang lesen (IMAP Benjamin)': 'Benjamin',\n};\nconst postfach = POSTFAECHER[$prevNode.name] || $prevNode.name;\nconst merk = $getWorkflowStaticData('global');\nconst gemeldet = new Set(merk.gemeldet || []);\n\nconst adressen = (l) => (Array.isArray(l) ? l : l ? [l] : [])\n  .map((x) => (typeof x === 'string' ? x : x.name ? x.name + ' <' + (x.address || '') + '>' : x.address || '')).filter(Boolean).join(', ');\nconst text = (v) => (v == null ? '' : typeof v === 'string' ? v : Array.isArray(v) ? v.map(text).join(' ') : typeof v === 'object' ? (v.text || v.address || '') : String(v));\n\nconst aus = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  // ein deaktivierter IMAP-Knoten reicht nur das Auslöser-Item durch – das ist keine Mail\n  if (j.uid == null && !j.envelope) continue;\n  const env = j.envelope || {};\n  // Kopfzeilen: je nach Version des IMAP-Knotens als Objekt oder als Rohtext\n  let h = j.headers || {};\n  if (typeof h === 'string') {\n    const roh = h.replace(/\\r?\\n[ \\t]+/g, ' ');\n    h = {};\n    for (const z of roh.split(/\\r?\\n/)) { const m = /^([^:\\s]+):\\s*(.*)$/.exec(z); if (m) h[m[1].toLowerCase()] = m[2]; }\n  }\n  const kopf = (n) => text(h[n] ?? h[n.toLowerCase()] ?? Object.entries(h).find(([k]) => k.toLowerCase() === n)?.[1]);\n  const datum = env.date || kopf('date') || '';\n  const zeit = datum ? new Date(datum).getTime() : NaN;\n  if (!Number.isNaN(zeit) && zeit < Date.now() - TAGE * 86400000) continue;\n  const message_id = text(env.messageId) || kopf('message-id');\n  const schluessel = postfach + '|' + (message_id || [j.mailboxPath || 'INBOX', j.uid, datum].join('|'));\n  if (gemeldet.has(schluessel)) continue;\n  const anhaenge = (j.attachmentsInfo || []).filter((a) => a && a.partId);\n  aus.push({ json: {\n    schluessel,\n    postfach,\n    ordner: j.mailboxPath || 'INBOX',\n    uid: j.uid,\n    von: adressen(env.from) || kopf('from'),\n    an: adressen(env.to) || kopf('delivered-to') || kopf('to'),\n    betreff: text(env.subject) || kopf('subject'),\n    datum: datum ? String(datum) : '',\n    message_id,\n    in_reply_to: text(env.inReplyTo) || kopf('in-reply-to'),\n    references: kopf('references'),\n    auto: kopf('auto-submitted'),\n    text: text(j.textContent || j.textPlain || j.text).slice(0, 200000),\n    html: text(j.htmlContent || j.textHtml || j.html).slice(0, 500000),\n    anhaenge_anzahl: anhaenge.length,\n  } });\n}\nreturn aus;\n"
      },
      "name": "Mail aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.anhaenge_anzahl }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Anhänge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "imapThisNode",
        "resource": "email",
        "operation": "downloadAttachment",
        "mailboxPath": {
          "__rl": true,
          "mode": "path",
          "value": "={{ $json.ordner }}"
        },
        "emailUid": "={{ $json.uid }}",
        "allAttachments": true,
        "includeInlineAttachments": false
      },
      "name": "Anhänge laden",
      "type": "n8n-nodes-imap.imap",
      "typeVersion": 1,
      "position": [
        960,
        -100
      ],
      "credentials": {
        "imapApi": {
          "id": "",
          "name": "IMAP Postfach Verein"
        }
      }
