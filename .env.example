# ---------------------------------------------------------------------------
# Portalbasis – Konfiguration. install.sh erzeugt daraus die .env
# (Passwörter werden dabei zufällig gesetzt).
# ---------------------------------------------------------------------------

# Projektname (Docker-Container heißen <name>-app, <name>-db, ...)
COMPOSE_PROJECT_NAME=portal

# Port, unter dem das Portal erreichbar ist (http://<server>:<port>)
PORTAL_PORT=8080

# Aktive Fachmodule: * = alle (Sichtbarkeit über Rollen/Berechtigungen), sonst kommagetrennt (tco,transport)
PORTAL_MODULES=*

# Datenbank
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=__ZUFALL__

# Auf true setzen, sobald das Portal nur noch per HTTPS erreichbar ist
SECURE_COOKIES=false
# Auf true setzen, wenn ein Reverse Proxy (Caddy, Nginx Proxy Manager) davor steht – dann gilt die Client-IP aus X-Forwarded-For
TRUST_PROXY=false
SESSION_HOURS=12

# Backup: Uhrzeit (HH:MM) und Aufbewahrung in Tagen
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30

# Ablageorte auf dem Server (relativ zum Installationsordner oder absolut, z. B. /mnt/nas/portal/…)
#   Portal-Sicherungen (Administration → Sicherung) und nächtliche Datenbank-Backups (Archiv mit Rotation)
SICHERUNG_PFAD=./data/sicherungen
BACKUP_PFAD=./data/backups

# Öffentliche Adresse des Portals (Links in E-Mails: Registrierung, Einladung, Kennwort). Leer = Einstellung im Portal
PORTAL_URL=

# Optionale Dienste im selben Stack (kommagetrennt): paperless, n8n, https
COMPOSE_PROFILES=

# Paperless-ngx (Profil paperless) – Passwörter/Schlüssel erzeugt install.sh
PAPERLESS_PORT=8000
PAPERLESS_PFAD=./data/paperless
PAPERLESS_URL=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=__ZUFALL__
PAPERLESS_DB_PASSWORD=__ZUFALL__
PAPERLESS_SECRET_KEY=__ZUFALL__

# n8n (Profil n8n)
N8N_PORT=5678
N8N_PFAD=./data/n8n
N8N_HOST=localhost
N8N_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=__ZUFALL__

# Optional: eigener HTTPS-Proxy (Caddy) mit automatischem Zertifikat.
# Domain eintragen und mit "docker compose --profile https up -d" starten.
PORTAL_DOMAIN=

TZ=Europe/Berlin
