{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@core/*": [
        "./web/src/*"
      ],
      "@modules/*": [
        "./modules/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "server/src",
    "server/test",
    "web/src",
    "modules"
  ]
}