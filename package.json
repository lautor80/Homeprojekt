{
  "name": "portal-basis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Portalbasis (Fiori-Optik) mit Benutzern, Rollen, Änderungsbelegen und Modulen",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "node scripts/fonts.mjs && vite --config web/vite.config.ts",
    "build:web": "node scripts/fonts.mjs && vite build --config web/vite.config.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "node --test --import tsx server/test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sap-theming/theming-base-content": "^11.36.4",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ui5/webcomponents": "^2.28.1",
    "@ui5/webcomponents-fiori": "^2.28.1",
    "@ui5/webcomponents-icons": "^2.28.1",
    "@ui5/webcomponents-react": "^2.28.2",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.6"
  }
}
